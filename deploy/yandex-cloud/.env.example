# Скопируйте в deploy/yandex-cloud/.env, если нужно поменять значения по умолчанию.
# Если .env нет, deploy.sh создаст его сам с именем единственного файла weights/*.pth.

# Имя файла весов в папке weights/
OKO_WEIGHTS_FILE=rfdetr_large_best_ema.pth

# Вариант RF-DETR для чекпойнтов старого формата: nano | small | medium | base | large
OKO_RFDETR_VARIANT=large

# Порядок классов, если чекпойнт не хранит имена (английские или русские названия через запятую).
# Пусто — имена из чекпойнта, иначе порядок ML-части:
# excavator,dump_truck,loader,crane_manipulator,mobile_crane,concrete_mixer,bulldozer,grader,tower_crane,drilling_rig
OKO_RFDETR_CLASSES=

# Минимальная уверенность рамки
OKO_DETECTOR_THRESHOLD=0.3

# Если huggingface.co недоступен с ВМ — адрес зеркала Hugging Face
# HF_ENDPOINT=https://huggingface.co

# ---------------- ИИ-анализ (кнопка «Анализ ИИ» в карточке снимка и «Анализ ИИ за день» на сводке)

# YandexGPT в Yandex AI Studio. Каталог — yc config get folder-id (deploy.sh подставит сам).
# Ключ не нужен, если к ВМ привязан сервисный аккаунт с ролью ai.languageModels.user
# (create-vm.sh и upgrade-vm.sh делают это сами): токен берётся из сервиса метаданных ВМ.
OKO_LLM_PROVIDER=yandex
OKO_YC_FOLDER_ID=
# yandexgpt-5.1 | yandexgpt-5-lite (дешевле) | aliceai-llm | qwen3.6-35b-a3b (видит сами изображения)
OKO_LLM_MODEL=yandexgpt-5.1
# Лимит ответа LLM в токенах (рассуждающие модели вроде qwen3.6 тратят его и на рассуждения)
# OKO_LLM_MAX_TOKENS=8000
# Рассуждения qwen3.6 / gpt-oss: off — выключить (ответ в разы быстрее) | model — как решит модель | low | medium | high
# OKO_LLM_REASONING=off
# API-ключ сервисного аккаунта — если ВМ без сервисного аккаунта или сервис не в Yandex Cloud
# OKO_LLM_API_KEY=

# Модель готовности (weights/readiness/<прогон>/head.pt + DINOv2 ViT-g): auto | off
OKO_READINESS=auto
# auto — bfloat16 (как при обучении, ≈2.6 ГБ) на процессоре с аппаратным bf16, иначе float32 (≈5 ГБ, быстрее
# на таком процессоре) | bfloat16 | float32
OKO_READINESS_DTYPE=auto

# Локальная VLM: auto — самая крупная Qwen3-VL, которая помещается в память (8B → 4B → 2B → SmolVLM2-500M) | off
OKO_VLM=auto
# Запускать VLM, даже если LLM сама видит кадр (qwen3.6): 0 — нет, быстрее на 1–3 минуты | 1 — да
# OKO_VLM_ALWAYS=0

# Кеш выводов моделей по содержимому кадра и загрузка моделей в память после старта: 1 | 0
# OKO_AI_CACHE=1
# OKO_AI_WARMUP=1
# LLM, которая сама видит кадр, не ждёт модель готовности (кадр зоны, быстрая проверка): 1 | 0 — по очереди
# OKO_AI_PARALLEL=1

# Анализировать ли каждый новый снимок автоматически (платные вызовы YandexGPT): 0 | 1
OKO_AI_AUTO=0
# Исправления ИИ (ложные рамки, пропущенная техника): manual — применяет инженер кнопкой | auto
OKO_AI_APPLY=manual
